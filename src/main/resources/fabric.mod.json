{
  "schemaVersion": 1,
  "id": "strongholdfinder",
  "version": "${version}",
  "name": "Stronghold Finder",
  "description": "Client-side Eye of Ender stronghold calculator for Minecraft 1.16.1, with one-eye boat eye measuring. Works with Toolscreen Mobile's Eye Measure mode.",
  "authors": [
    "Adam Armanyos"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.adamarmanyos.stronghold.StrongholdFinderClient"
    ]
  },
  "mixins": [
    "strongholdfinder.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "1.16.1"
  },
  "suggests": {
    "toolscreen-mobile": "*"
  }
}
